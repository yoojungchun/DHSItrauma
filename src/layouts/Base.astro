---
import '../styles/global.css';
import { course } from '../data/course.ts';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${course.title} — ${course.subtitle}`,
  description = 'A seminar on how suffering becomes narrative, and narrative becomes both weapon and commodity.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <a href="#schedule" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-paper">
      Skip to schedule
    </a>

    <slot />

    <script>
      import '../scripts/progress.ts';
      import '../scripts/reveal.ts';
    </script>
  </body>
</html>
