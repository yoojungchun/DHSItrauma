---
interface Props {
  numeral: string;
  title: string;
  id?: string;
}
const { numeral, title, id } = Astro.props;
---

<div id={id} class="flex items-end gap-5 border-b-2 border-ink pb-4">
  <span class="label shrink-0 text-accent">{numeral}</span>
  <h2
    class="font-display text-[clamp(1.75rem,6vw,4rem)] font-semibold uppercase leading-[0.9] tracking-tight"
  >
    {title}
  </h2>
</div>
