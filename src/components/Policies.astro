---
import SectionHeading from './SectionHeading.astro';
import { policies } from '../data/course.ts';
---

<section id="policies" class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28">
  <SectionHeading numeral="04 / Terms" title="Policies" />

  <dl class="reveal mt-10 divide-y divide-line border-t-2 border-ink">
    {
      policies.map((p) => (
        <div class="grid gap-2 py-6 sm:grid-cols-[1fr_2fr] sm:gap-12">
          <dt class="font-display text-lg font-medium leading-tight">{p.heading}</dt>
          <dd class="leading-relaxed text-ink/80">{p.body}</dd>
        </div>
      ))
    }
  </dl>
</section>
